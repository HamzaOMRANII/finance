# Copy to .env (chmod 600) and fill in. .env is gitignored.
HOST=127.0.0.1
PORT=17000
PUBLIC_URL=https://finance.omranisystems.com
# Business timezone for "today", schedules and the cron guard.
TZ=Africa/Lagos

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_DAYS=7

# Notifications (bills report, approvals, reminders) go here; it is also BCC'd on client emails.
OWNER_EMAIL=you@example.com
# Gmail: use an App Password (Google account > Security > App passwords), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_FROM="Your Name <you@example.com>"

# Optional: Claude reads scanned receipts/images on the Receipts page.
RECEIPTS_AI=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional overrides (defaults shown)
# DB_FILE=data/fintrack.db
# RECEIPTS_DIR=data/receipts
# ISSUED_DIR=data/issued-invoices
# LOGS_DIR=automation/logs
BACKUP_DIR=/root/backups/finance
